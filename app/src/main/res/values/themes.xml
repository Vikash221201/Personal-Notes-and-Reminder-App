<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.PersonalNotesReminder" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main Palette Colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>

        <!-- Status and Navigation Bars -->
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Material Card & Popup Theme -->
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
        <item name="popupMenuStyle">@style/Widget.Material3.PopupMenu</item>
    </style>

    <style name="Theme.PersonalNotesReminder" parent="Base.Theme.PersonalNotesReminder" />
</resources>
